# ============================================
# Environment Variables Configuration
# متغيرات البيئة - تكوين التطبيق
# ============================================

# Supabase Configuration
# تكوين سوبابيس - قاعدة البيانات والمصادقة
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Claude API Configuration
# تكوين Claude API - خدمة الذكاء الاصطناعي
VITE_CLAUDE_API_KEY=YOUR_CLAUDE_API_KEY

# ============================================
# ملاحظات أمان مهمة - Security Notes
# ============================================
# 1. لا تشارك هذه الملفات في الـ Git
#    Do not commit .env files to Git
#
# 2. أضف .env إلى .gitignore
#    Add .env to .gitignore file
#
# 3. استخدم GitHub Secrets للـ CI/CD
#    Use GitHub Secrets for CI/CD pipelines
#
# 4. احفظ المفاتيح في مكان آمن
#    Keep keys in a secure location
# ============================================
